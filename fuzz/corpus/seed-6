on: pull_request_target
permissions: {contents: write}
jobs:
  a:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.ref }}
      - uses: ./.github/actions/setup
      - run: echo "x=${{ github.head_ref }}" >> "$GITHUB_OUTPUT"
